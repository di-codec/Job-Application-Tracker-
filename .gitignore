# Dependencies
node_modules/

# Build output
dist/
build/
*.local

# Environment variables & secrets (never commit)
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials.*.json
secrets.json
.secrets
*.secret

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# SQLite database (job applications, salaries, notes)
backend/data/*
!backend/data/.gitkeep
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Uploaded resumes & documents (personal files)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# OS-generated files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
*~
.vscode/settings.json

# Test & coverage
coverage/
.nyc_output/

# Cache & temp
.cache/
.temp/
tmp/
temp/
*.tmp

# Optional local overrides
docker-compose.override.yml
docker-compose.override.yaml
